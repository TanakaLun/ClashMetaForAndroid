<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeLight" parent="@style/Theme.Material3.Light.NoActionBar">
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOutline</item>
        
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Material3.HeadlineSmall</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="textAppearanceHeadline6">?attr/textAppearanceHeadlineSmall</item>
        
        <item name="android:showText">false</item>
    </style>

    <style name="AppThemeDark" parent="@style/Theme.Material3.Dark.NoActionBar">
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOutline</item>
        
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Material3.HeadlineSmall</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="textAppearanceHeadline6">?attr/textAppearanceHeadlineSmall</item>
        
        <item name="android:showText">false</item>
    </style>
</resources>
