<resources>
    <style name="AppThemeLight" parent="@style/Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_clash_light</item>
        <item name="colorSurface">@color/color_light_background</item>
        <item name="android:showText">false</item>
    </style>

    <style name="AppThemeDark" parent="@style/Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/color_clash_dark</item>
        <item name="colorSurface">@color/color_dark_surface</item>
        <item name="android:showText">false</item>
    </style>

    <style name="AppBottomSheetDialogLight" parent="@style/Theme.Material3.Light.BottomSheetDialog" />
    <style name="AppBottomSheetDialogDark" parent="@style/Theme.Material3.Dark.BottomSheetDialog" />
</resources>
